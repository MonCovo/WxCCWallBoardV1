# --- Runtime ---
PORT=3001
MOCK_DATA=true
WALLBOARD_TITLE=Contact Center Wallboard
SNAPSHOT_INTERVAL_MS=30000
# Optional: require header X-Display-Key or ?key= for /api/snapshot
DISPLAY_KEY=

# --- Webex Service App (required when MOCK_DATA=false) ---
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_ACCESS_TOKEN=
WEBEX_REFRESH_TOKEN=
WEBEX_ORG_ID=

# Regional WxCC API base (no trailing slash), e.g. https://api.wxcc-us1.webex.com
WXCC_API_BASE=

# IANA timezone for "start of day" query window
ORG_TIMEZONE=UTC
