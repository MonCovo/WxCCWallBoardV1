# --- Runtime ---
PORT=3001
MOCK_DATA=true
WALLBOARD_TITLE=Contact Center Wallboard
SNAPSHOT_INTERVAL_MS=30000
# Optional: require header X-Display-Key or ?key= for /api/snapshot
DISPLAY_KEY=

# --- Webex Service App (required when MOCK_DATA=false) ---
# Create a Service App with scope cjp:config_read, authorize in Control Hub,
# then set these. The wallboard mints & refreshes access tokens itself.
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_APP_ID=
WEBEX_ORG_ID=

# Bearer used ONLY to mint Service App tokens via
# POST /v1/applications/{appId}/token (Webex platform requirement).
# Use a Personal Access Token from developer.webex.com, OR an access token
# from a separate integration that has spark:applications_token.
# Search API calls use the minted Service App tokens, not this value.
WEBEX_APPLICATIONS_TOKEN=

# Regional WxCC API base (no trailing slash), e.g. https://api.wxcc-us1.cisco.com
# UK: api.wxcc-eu1.cisco.com  Germany: api.wxcc-eu2.cisco.com  US: api.wxcc-us1.cisco.com
WXCC_API_BASE=

# IANA timezone for "start of day" query window
ORG_TIMEZONE=UTC

# Optional legacy: portal-copied tokens (usually leave blank — app mints these)
# WEBEX_ACCESS_TOKEN=
# WEBEX_REFRESH_TOKEN=
